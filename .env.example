# API Configuration
# Base URL for the backend API
# The application currently uses a hardcoded URL in src/api/api.ts.
# To use this variable, you would need to update axios setup to use import.meta.env.VITE_API_URL
VITE_API_URL=http://localhost:3000

# Optional: Port for the frontend dev server (default is 5173)
# PORT=5173
